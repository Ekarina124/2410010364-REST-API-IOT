    {
        "id": "proc_kontrol",
        "type": "function",
        "z": "4a69a85be7e3ea1b",
        "name": "Validasi & Publish",
        "func": "const API_KEY = 'iotkampus2026';\nif (msg.req.headers['x-api-key'] !== API_KEY) {\n    msg.statusCode = 401;\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    msg.payload = {status: 'error', message: 'API key tidak valid'};\n    return [msg, null];\n}\n\nvar body = msg.payload;\nif (!body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n    return [msg, null];\n}\n\nvar mqttMsg = {topic: 'iot/kontrol', payload: body};\n\nmsg.statusCode = 200;\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nmsg.payload = {status: 'success', message: 'Perintah terkirim', sent: body};\nreturn [msg, mqttMsg];",
