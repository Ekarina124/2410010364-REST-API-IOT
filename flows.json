        "id": "c1f03f7a6d06d6eb",
        "type": "function",
        "z": "4a69a85be7e3ea1b",
        "name": "Simpan Data ke DB",
        "func": "var data = msg.payload;\n\nmsg.topic = `\nINSERT INTO sensor_data\n(suhu, kelembaban, timestamp, received)\nVALUES ($suhu, $kelembaban, $timestamp, $received)\n`;\n\nmsg.payload = [\n    data.suhu,\n    data.kelembaban,\n    data.timestamp,\n    data.received\n];\n\nreturn msg;",
