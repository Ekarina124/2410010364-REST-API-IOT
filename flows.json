    {
        "id": "store_sensor",
        "type": "function",
        "z": "4a69a85be7e3ea1b",
        "name": "Simpan Data Sensor",
        "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\n// history max 50 data\nvar history = flow.get('history') || [];\nhistory.push(data);\nif (history.length > 50) history.shift();\nflow.set('history', history);\n\n// cek batas suhu (default 30 kalau belum pernah di-set)\nvar th = flow.get('threshold');\nif (th === undefined) th = 30;\nvar over = Number(data.suhu) > Number(th);\nflow.set('overThreshold', over);\n\n// output 2: notifikasi MQTT, hanya kalau suhu melewati batas\nvar alertMsg = null;\nif (over) {\n    alertMsg = {\n        topic: 'iot/alert',\n        payload: { pesan: 'Suhu melewati batas', suhu: data.suhu, batas: th, waktu: data.received }\n    };\n    node.warn('ALERT: suhu ' + data.suhu + ' melewati batas ' + th);\n}\n\nreturn [msg, alertMsg];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 930,
        "y": 640,
        "wires": [
