    {
        "id": "2993b46230d0c039",
        "type": "function",
        "z": "4a69a85be7e3ea1b",
        "name": "Set Threshold",
        "func": "const API_KEY = 'iotkampus2026';\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\n\nif (msg.req.headers['x-api-key'] !== API_KEY) {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key tidak valid'};\n    return msg;\n}\n\nvar max = Number(msg.payload && msg.payload.max);\nif (msg.payload === undefined || msg.payload.max === undefined || isNaN(max)) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: \"field 'max' wajib berupa angka\"};\n    return msg;\n}\n\nflow.set('threshold', max);\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Batas suhu diperbarui', threshold: max};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
